# AWS Credentials (optional if using ~/.aws/credentials or IAM role)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# AWS Region (defaults to us-east-1 if not set)
AWS_REGION=us-east-1

# Kendra Index ID (required) - Get this from AWS Console > Kendra > Your Index
# Format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
KENDRA_INDEX_ID=your_index_id

# Kendra IAM Role ARN (required for creating indexes or data sources)
# Format: arn:aws:iam::ACCOUNT_ID:role/ROLE_NAME
KENDRA_ROLE_ARN=arn:aws:iam::123456789012:role/KendraIndexRole

# S3 Bucket Name (optional - only needed if using S3 as a data source)
S3_BUCKET_NAME=your-bucket-name
